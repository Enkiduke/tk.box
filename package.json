{
  "name": "tk.box",
  "version": "0.0.1",
  "private": true,
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=22.11.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:readonly": "tsx watch apps/server/src/index.ts --read-only",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "preview:ui": "tsx scripts/preview-ui.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/apps/server/src/index.js",
    "start:readonly": "node dist/apps/server/src/index.js --read-only",
    "test": "tsx --test tests/*.test.ts",
    "spike:media": "tsx scripts/media-spike.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "spike:serve": "tsx scripts/serve-spike.ts",
    "smoke:built": "tsx scripts/smoke-built.ts",
    "spike:timing": "tsx scripts/timestamp-spike.ts",
    "spike:live:prepare": "tsx scripts/prepare-live.ts",
    "spike:live:check": "tsx scripts/check-live.ts",
    "spike:live:serve": "tsx scripts/serve-live.ts",
    "verify:plex": "tsx scripts/verify-plex.ts",
    "setup:plex": "node --env-file=.env --import tsx scripts/setup-plex.ts",
    "verify:catalog": "node --env-file=.env --import tsx scripts/check-catalog.ts",
    "fixture:live": "tsx scripts/live-fixture.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^10.3.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "hls.js": "^1.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
