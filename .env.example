# Local development: Node --env-file=.env is supported on the selected runtime.
# npm scripts do not implicitly load this file. See README commands.
APP_HOST=127.0.0.1
APP_PORT=3000
DEPLOYMENT_MODE=local
# Remote installation requires an HTTPS origin, without a path.
# PUBLIC_BASE_URL=https://media.example.com
TRUSTED_PROXY_CIDRS=
DATA_DIR=./data
CACHE_DIR=./data/cache
# A persistent random key is created at DATA_DIR/secret.key (mode 0600) on first run. Protect it separately.
# A SECRET_KEY_FILE that does not exist stops startup; tk.box never creates a key at a named path.
# SECRET_KEY_FILE=/etc/tk.box/secret.key
PLEX_URL=http://127.0.0.1:32400
# After setting PLEX_URL, discover IDs with npm run setup:plex -- start / finish.
# Use stable numeric account ID and machine identifier, never username/email.
# PLEX_OWNER_ACCOUNT_ID=
# PLEX_MACHINE_ID=
# Comma-separated required Movies and TV section keys, e.g. 1,2.
PLEX_REQUIRED_LIBRARY_IDS=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Artwork (Admin › Artwork): a Python 3.10+ with apps/artwork/requirements.txt installed, ideally its own venv:
#   python3 -m venv /opt/tk.box/artwork-venv && /opt/tk.box/artwork-venv/bin/pip install -r apps/artwork/requirements.txt
PYTHON_PATH=python3
# Same-host mode (optional): when tk.box runs on the Plex server, read media parts from disk
# instead of over Plex HTTP. A file is opened (read-only) only after Plex authorizes the item
# and only if its real path, symlinks resolved, lies inside one of these absolute directories.
# Separate entries with ':' on Linux/macOS and ';' on Windows. Unset = Plex HTTP only.
# MEDIA_ROOTS=/srv/media/movies:/srv/media/tv
# When Plex sees other paths than tk.box (Docker), map Plex prefixes to local ones:
# PLEX_PATH_MAP=/movies=/srv/media/movies:/tv=/srv/media/tv
# Proposed local fixture/cache guard. Production cache worker is not wired yet.
SEGMENT_CACHE_MAX_BYTES=2147483648
# Read-only live verification inputs; file paths only, never token contents.
# PLEX_TEST_OWNER_TOKEN_FILE=
# PLEX_TEST_VIEWER_TOKEN_FILE=
# PLEX_TEST_UNAUTHORIZED_TOKEN_FILE=
# PLEX_TEST_READ_ITEM=
# Sports events (per M3U source: Settings → Sports events). Empty lists use the built-in defaults:
# major US leagues, top European soccer, UFC, F1, NASCAR and PGA from ESPN; boxing and WWE from TheSportsDB.
# These lists set which schedules are downloaded. Which leagues are shown, and in what order, is set in
# Settings → Live Sports. API keys are never set here: they are saved, encrypted, in Admin › Connections.
# SPORTS_ESPN_LEAGUES=football/nfl,basketball/nba,soccer/eng.1,mma/ufc
# SPORTS_TSDB_LEAGUES=4445,4444
# SPORTS_NAME_TIMEZONE=America/New_York
