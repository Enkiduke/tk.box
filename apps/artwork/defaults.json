{
  "default_layout": "tk-movies",
  "layout_by_type": {
    "movie": "tk-movies",
    "tv": "tk-tv",
    "custom": "tk-custom",
    "collection": "tk-collections",
    "streaming": "tk-streaming",
    "chart": "tk-charts"
  },
  "layouts": {
    "tk-movies": {
      "badges": [
        "gradient_top",
        "resolution",
        "edition",
        "codec",
        "audience_score"
      ],
      "resolution_font_file": "resources/fonts/Poppins/Poppins-ExtraBold.ttf",
      "resolution_font_size": 60,
      "edition_font_file": "resources/fonts/Poppins/Poppins-Regular.ttf",
      "edition_font_size": 58,
      "badge_text_color": "#FFFFFF",
      "width": 2000,
      "height": 3000,
      "poster_zoom": 1,
      "poster_shift_y": -0.04,
      "matte_height_ratio": 0.04,
      "fade_height_ratio": 0.36,
      "vignette_strength": 0.03,
      "grain_amount": 0,
      "grain_seed": null,
      "uniform_logo_max_w": 1800,
      "uniform_logo_max_h": 600,
      "uniform_logo_offset_x": 0.5,
      "uniform_logo_offset_y": 0.82,
      "uniform_logo_h_align": "center",
      "uniform_logo_v_align": "center",
      "poster_filter": "textless",
      "logo_preference": "color",
      "logo_min_brightness": 70,
      "logo_mode": "original",
      "border_enabled": false,
      "border_px": 0,
      "border_color": "#FFFFFF",
      "text_overlay_enabled": false,
      "custom_text": "",
      "font_file": null,
      "font_size": 120,
      "text_color": "#FFFFFF",
      "text_transform": "none",
      "letter_spacing": 0,
      "position_y": 0.5,
      "badge_stroke_width": 4,
      "badge_shadow_strength": 1,
      "badge_shadow_blur": 4,
      "badge_stroke_opacity": 0.5,
      "uniform_logo_shadow_enabled": true,
      "uniform_logo_trim": true,
      "uniform_logo_shadow_opacity": 100,
      "uniform_logo_shadow_angle": 0,
      "uniform_logo_shadow_distance": 0,
      "uniform_logo_shadow_size": 24,
      "uniform_logo_shadow_spread": 50,
      "grain_mode": "blend",
      "fade_smoothness": 1,
      "audience_score_text_color": "#000000",
      "audience_score_font_size": 72,
      "badge_art_shadow_enabled": true,
      "badge_art_shadow_angle": 0,
      "badge_art_shadow_opacity": 100,
      "badge_art_shadow_distance": 0,
      "badge_art_shadow_spread": 100,
      "badge_art_shadow_size": 4,
      "badge_gradient_top_height": 0.05,
      "badge_gradient_top_strength": 0.5
    },
    "tk-tv": {
      "badges": [
        "gradient_top",
        "status_banner"
      ],
      "streaming_logo_shadow_enabled": true,
      "streaming_logo_shadow_opacity": 100,
      "streaming_logo_shadow_angle": 0,
      "streaming_logo_shadow_distance": 0,
      "streaming_logo_shadow_size": 4,
      "streaming_logo_shadow_spread": 100,
      "width": 2000,
      "height": 3000,
      "poster_zoom": 1,
      "poster_shift_y": -0.04,
      "matte_height_ratio": 0.18,
      "fade_height_ratio": 0.14,
      "vignette_strength": 0.03,
      "grain_amount": 0,
      "grain_seed": null,
      "uniform_logo_max_w": 1800,
      "uniform_logo_max_h": 600,
      "uniform_logo_offset_x": 0.5,
      "uniform_logo_offset_y": 0.8,
      "uniform_logo_h_align": "center",
      "uniform_logo_v_align": "bottom",
      "uniform_logo_center_below": 0,
      "poster_filter": "textless",
      "logo_preference": "color",
      "logo_min_brightness": 70,
      "logo_mode": "original",
      "border_enabled": false,
      "border_px": 0,
      "border_color": "#FFFFFF",
      "text_overlay_enabled": false,
      "custom_text": "",
      "font_file": null,
      "font_size": 120,
      "text_color": "#FFFFFF",
      "text_transform": "none",
      "letter_spacing": 0,
      "position_y": 0.5,
      "uniform_logo_trim": true,
      "uniform_logo_shadow_enabled": true,
      "uniform_logo_shadow_opacity": 100,
      "uniform_logo_shadow_angle": 0,
      "uniform_logo_shadow_distance": 0,
      "uniform_logo_shadow_size": 24,
      "uniform_logo_shadow_spread": 60,
      "streaming_logo_max_w": 160,
      "streaming_logo_source": "originals",
      "status_banners": {
        "canceled": {
          "backdrop": false,
          "color": "#E23133",
          "opacity": 1,
          "text": "CANCELED",
          "weight": 10
        },
        "ended": {
          "backdrop": false,
          "color": "#FF9138",
          "opacity": 1,
          "text": "ENDED",
          "weight": 10
        },
        "final_episode": {
          "backdrop": "#E23133",
          "color": "#000000",
          "days": 7,
          "opacity": 1,
          "text": "FINAL EPISODE",
          "weight": 30
        },
        "new_episode": {
          "backdrop": "#F5C518",
          "color": "#000000",
          "days": 1,
          "enabled": true,
          "opacity": 1,
          "text": "NEW EPISODE",
          "weight": 45
        },
        "new_season": {
          "backdrop": "#5CB85C",
          "color": "#000000",
          "days": 31,
          "opacity": 1,
          "text": "SEASON {season} AIRS {date}",
          "weight": 25
        },
        "new_season_started": {
          "backdrop": "#5CB85C",
          "color": "#000000",
          "days": 7,
          "opacity": 1,
          "text": "SEASON {season} STARTED",
          "weight": 35
        },
        "new_show": {
          "backdrop": "#F5C518",
          "color": "#000000",
          "days": 7,
          "opacity": 1,
          "text": "RECENTLY ADDED",
          "weight": 50
        },
        "returning": {
          "backdrop": false,
          "color": "#5CB85C",
          "opacity": 1,
          "text": "RETURNING",
          "weight": 10
        },
        "season_finale": {
          "backdrop": "#FF9138",
          "color": "#000000",
          "days": 7,
          "opacity": 1,
          "text": "SEASON {season} FINALE",
          "weight": 30
        },
        "upcoming_episode": {
          "backdrop": "#0085C6",
          "color": "#000000",
          "days": 31,
          "opacity": 1,
          "text": "NEXT EPISODE {date}",
          "weight": 20
        },
        "upcoming_finale": {
          "backdrop": "#0085C6",
          "color": "#000000",
          "days": 31,
          "opacity": 1,
          "text": "FINALE AIRS {date}",
          "weight": 40
        }
      },
      "badge_gradient_top_strength": 0.5,
      "badge_gradient_top_height": 0.05,
      "status_banner_date_format": "dd/mmm",
      "status_banner_simplify_dates": true,
      "status_banner_font_file": "resources/fonts/Poppins/Poppins-Medium.ttf"
    },
    "tk-tv-season": {
      "extends": "tk-tv",
      "role": "season",
      "uniform_logo_max_w": 1500,
      "uniform_logo_max_h": 500,
      "uniform_logo_offset_y": 0.83,
      "logo_mode": "original",
      "text_overlay_enabled": true,
      "custom_text": "{season}",
      "font_size": 150,
      "letter_spacing": 1,
      "position_y": 0.95,
      "text_transform": "uppercase",
      "uniform_logo_trim": true,
      "uniform_logo_shadow_enabled": true,
      "uniform_logo_shadow_opacity": 100,
      "uniform_logo_shadow_angle": 0,
      "uniform_logo_shadow_distance": 0,
      "uniform_logo_shadow_size": 24,
      "uniform_logo_shadow_spread": 50
    },
    "tk-tv-episode": {
      "extends": "tk-tv",
      "role": "episode",
      "width": 3200,
      "height": 1800,
      "logo_mode": "original",
      "uniform_logo_max_w": 1155,
      "uniform_logo_max_h": 650,
      "text_transform": "uppercase",
      "card_gradient": "radial",
      "gradient_center_x": 0.68,
      "gradient_center_y": 0.48,
      "gradient_radius_x": 0.465,
      "gradient_radius_y": 0.6,
      "gradient_softness": 4,
      "gradient_strength": 1.0,
      "gradient_corner_strength": 0.35,
      "title_color": "auto",
      "title_min_brightness": 60,
      "stroke_opacity": 0.9,
      "title_stroke_width": 16,
      "index_stroke_width": 12,
      "shadow_strength": 0.5,
      "shadow_blur": 18,
      "shadow_offset_y": 0,
      "title_font_file": "resources/fonts/Poppins/Poppins-Medium.ttf",
      "season_font_file": "resources/fonts/Poppins/Poppins-Medium.ttf",
      "episode_font_file": "resources/fonts/Poppins/Poppins-Medium.ttf",
      "card_logo_offset_x": 0,
      "card_logo_offset_y": 0,
      "card_logo_h_align": "left",
      "card_logo_v_align": "top",
      "card_logo_trim": true,
      "card_logo_shadow_enabled": true,
      "card_logo_shadow_color": "#000000",
      "card_logo_shadow_opacity": 100,
      "card_logo_shadow_angle": 0,
      "card_logo_shadow_distance": 0,
      "card_logo_shadow_size": 24,
      "card_logo_shadow_spread": 50,
      "title_letter_spacing": -1.25,
      "title_line_spacing": -22,
      "title_x": 50,
      "title_bottom": 125,
      "title_stroke_color": "auto",
      "index_letter_spacing": 5.42,
      "index_gap": 30,
      "index_x": 50,
      "index_bottom": 50,
      "index_stroke_color": "#000000",
      "shadow_color": "#000000",
      "index_font_size": 90
    },
    "tk-collections": {
      "logo_mode": "none",
      "poster_filter": "text"
    },
    "tk-streaming": {
      "uniform_logo_max_w": 1400,
      "uniform_logo_max_h": 1000,
      "uniform_logo_offset_x": 0.5,
      "uniform_logo_offset_y": 0.5
    },
    "tk-charts": {
      "uniform_logo_max_w": 1100,
      "uniform_logo_max_h": 600,
      "uniform_logo_offset_x": 0.5,
      "uniform_logo_offset_y": 0.36,
      "text_overlay_enabled": true,
      "custom_text": "{title_lines}",
      "text_transform": "uppercase",
      "font_file": "resources/fonts/Poppins/Poppins-Regular.ttf",
      "font_size": 230,
      "text_color": "#FFFFFF",
      "position_y": 0.66
    },
    "tk-custom": {
      "font_file": "resources/fonts/Poppins/Poppins-Regular.ttf",
      "uniform_logo_max_w": 1600,
      "uniform_logo_max_h": 2200,
      "uniform_logo_offset_x": 0.5,
      "uniform_logo_offset_y": 0.5,
      "uniform_logo_trim": true,
      "uniform_logo_shadow_enabled": true,
      "uniform_logo_shadow_opacity": 100,
      "uniform_logo_shadow_angle": 0,
      "uniform_logo_shadow_distance": 0,
      "uniform_logo_shadow_size": 24,
      "uniform_logo_shadow_spread": 50
    }
  }
}
